# Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit your real .env file or real credentials to version control.

# Server Configuration (if running server/server.js)
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS security (Netlify domain or custom domain)
FRONTEND_ORIGIN=https://rakeshgr.netlify.app

# Optional Email / Notification Service Credentials (placeholder only)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_user_here
# SMTP_PASS=your_password_here
